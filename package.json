{
  "name": "ikarp-blog-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "migrate": "node migration/migrate.mjs",
    "build": "hexo clean && hexo generate",
    "build:leon-root": "hexo clean && hexo generate --config _config.yml,_config.leon-root-pages.yml",
    "publish:leon": "node tools/publish-leon-root.mjs",
    "verify": "node migration/verify.mjs",
    "verify:features": "node --test tests/features-built.mjs",
    "server": "hexo server"
  },
  "hexo": {
    "version": "8.1.2"
  },
  "dependencies": {
    "cheerio": "1.2.0",
    "hexo": "8.1.2",
    "hexo-generator-archive": "2.0.0",
    "hexo-generator-category": "2.0.0",
    "hexo-generator-index": "4.0.0",
    "hexo-generator-searchdb": "1.5.0",
    "hexo-generator-tag": "2.0.0",
    "hexo-renderer-marked": "7.0.1",
    "hexo-renderer-pug": "3.0.0",
    "hexo-renderer-stylus": "3.0.1",
    "hexo-server": "3.0.0",
    "hexo-theme-butterfly": "5.7.0",
    "turndown": "7.2.4",
    "turndown-plugin-gfm": "1.0.2",
    "yaml": "2.9.1"
  }
}
